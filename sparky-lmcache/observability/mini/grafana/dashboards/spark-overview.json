{
  "uid": "sparky-overview",
  "title": "Sparky \u2014 two-node overview",
  "tags": [
    "sparky",
    "dgx-spark"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom"
        },
        "query": "label_values(node_memory_MemAvailable_bytes, node)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "benchmark runs",
        "datasource": {
          "type": "prometheus",
          "uid": "prom"
        },
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 1)",
        "expr": "bench_run_info == 1",
        "titleFormat": "run {{run_id}}",
        "textFormat": "{{model}} / {{arm}}  chunk={{chunk}} l1={{l1}} util={{util}} clock={{clock_mhz}}"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Active run",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [
        {
          "type": "table",
          "title": "Active run",
          "description": "One row per run, not per node. bench_run_info is written by each node's textfile collector so it exists twice, and other panels need that to join a metric to a run. Here it is collapsed with max by().\n\nclock_mhz, clock_max_mhz and image are dropped: the clocks belong on the GPU panels and the image is recorded per arm in runs/<id>/manifest.yaml, which is more reliable than a label.",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "gridPos": {
            "h": 6,
            "w": 24,
            "x": 0,
            "y": 1
          },
          "targets": [
            {
              "expr": "max by (run_id, model, arm, chunk, conc) (bench_run_info == 1)",
              "refId": "A",
              "format": "table",
              "instant": true,
              "datasource": {
                "type": "prometheus",
                "uid": "prom"
              }
            },
            {
              "expr": "max by (run_id) (bench_run_start_seconds and on(run_id) (bench_run_info == 1))",
              "refId": "B",
              "format": "table",
              "instant": true,
              "datasource": {
                "type": "prometheus",
                "uid": "prom"
              }
            },
            {
              "expr": "time() - max by (run_id) (bench_run_start_seconds and on(run_id) (bench_run_info == 1))",
              "refId": "C",
              "format": "table",
              "instant": true,
              "datasource": {
                "type": "prometheus",
                "uid": "prom"
              }
            }
          ],
          "transformations": [
            {
              "id": "joinByField",
              "options": {
                "byField": "run_id",
                "mode": "outer"
              }
            },
            {
              "id": "filterFieldsByName",
              "options": {
                "include": {
                  "pattern": "^(run_id|model|arm|chunk|conc|Value #B|Value #C)$"
                }
              }
            },
            {
              "id": "organize",
              "options": {
                "excludeByName": {},
                "renameByName": {
                  "run_id": "run",
                  "Value #B": "started",
                  "Value #C": "age"
                },
                "indexByName": {
                  "run_id": 0,
                  "model": 1,
                  "arm": 2,
                  "chunk": 3,
                  "conc": 4,
                  "Value #B": 5,
                  "Value #C": 6
                }
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "align": "left",
                "minWidth": 50,
                "cellOptions": {
                  "type": "auto"
                },
                "inspect": false
              }
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "run"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 200
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "model"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 70
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "arm"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 80
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "chunk"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 70
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "conc"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 60
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "started"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 175
                  },
                  {
                    "id": "unit",
                    "value": "dateTimeAsIso"
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "age"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 90
                  },
                  {
                    "id": "unit",
                    "value": "s"
                  },
                  {
                    "id": "decimals",
                    "value": 0
                  }
                ]
              }
            ]
          },
          "options": {
            "showHeader": true,
            "footer": {
              "show": false
            },
            "cellHeight": "sm"
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Runs in selected time range",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "panels": [
        {
          "type": "table",
          "title": "Runs in selected time range",
          "description": "Runs that were active or stopped inside the dashboard time range. Active history comes from max_over_time(bench_run_info[$__range]); completed-run visibility comes from bench_run_stop_seconds bounded by the selected Grafana from/to timestamps. Rows are collapsed by run_id because every Spark node exports the same run label set.",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "gridPos": {
            "h": 6,
            "w": 24,
            "x": 0,
            "y": 2
          },
          "targets": [
            {
              "expr": "max by (run_id, model, arm, chunk, conc) (max_over_time(bench_run_info[$__range])) > 0",
              "refId": "A",
              "format": "table",
              "instant": true,
              "datasource": {
                "type": "prometheus",
                "uid": "prom"
              }
            },
            {
              "expr": "max by (run_id) (max_over_time(bench_run_start_seconds[$__range]))",
              "refId": "B",
              "format": "table",
              "instant": true,
              "datasource": {
                "type": "prometheus",
                "uid": "prom"
              }
            },
            {
              "expr": "max by (run_id) ((bench_run_stop_seconds >= ${__from:date:seconds}) and (bench_run_stop_seconds <= ${__to:date:seconds}))",
              "refId": "C",
              "format": "table",
              "instant": true,
              "datasource": {
                "type": "prometheus",
                "uid": "prom"
              }
            }
          ],
          "transformations": [
            {
              "id": "joinByField",
              "options": {
                "byField": "run_id",
                "mode": "outer"
              }
            },
            {
              "id": "filterFieldsByName",
              "options": {
                "include": {
                  "pattern": "^(run_id|model|arm|chunk|conc|Value #B|Value #C)$"
                }
              }
            },
            {
              "id": "organize",
              "options": {
                "excludeByName": {},
                "renameByName": {
                  "run_id": "run",
                  "Value #B": "started",
                  "Value #C": "stopped"
                },
                "indexByName": {
                  "run_id": 0,
                  "model": 1,
                  "arm": 2,
                  "chunk": 3,
                  "conc": 4,
                  "Value #B": 5,
                  "Value #C": 6
                }
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "align": "left",
                "minWidth": 50,
                "cellOptions": {
                  "type": "auto"
                },
                "inspect": false
              }
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "run"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 200
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "model"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 70
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "arm"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 80
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "chunk"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 70
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "conc"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 60
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "started"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 175
                  },
                  {
                    "id": "unit",
                    "value": "dateTimeAsIso"
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "stopped"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 175
                  },
                  {
                    "id": "unit",
                    "value": "dateTimeAsIso"
                  }
                ]
              }
            ]
          },
          "options": {
            "showHeader": true,
            "footer": {
              "show": false
            },
            "cellHeight": "sm"
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "GPU",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "SM clock",
      "description": "The 513 MHz USB-PD clamp is visible here directly. Sustained values far below 2200 mean the machine is throttled, not slow.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_SM_CLOCK{node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rothz",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 600
              },
              {
                "color": "green",
                "value": 1800
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Power draw",
      "description": "Hard power-off is documented above roughly 90 W. Power is also the reliable load signal here - GPU_UTIL is not.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_POWER_USAGE{node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Temperature",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_GPU_TEMP{node=~\"$node\"}",
          "legendFormat": "{{node}} gpu"
        },
        {
          "refId": "B",
          "expr": "DCGM_FI_DEV_MEMORY_TEMP{node=~\"$node\"}",
          "legendFormat": "{{node}} mem"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Clock throttle reasons",
      "description": "Bitmask. Non-zero means the clock drop above has an attributable cause: USB-PD clamp, thermal, power cap or sync boost.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_CLOCK_THROTTLE_REASONS{node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Power draw per node, rate of energy",
      "description": "TOTAL_ENERGY_CONSUMPTION is a counter in mJ. Divided by generated tokens this gives joules per token.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION{node=~\"$node\"}[1m]) / 1000",
          "legendFormat": "{{node}} J/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Joules per generated token",
      "description": "Requires vLLM to be serving. Energy counter over token counter - the efficiency number almost nobody publishes for this class of hardware.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (rate(DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION{node=~\"$node\"}[5m]) / 1000) / sum by (node) (rate(vllm:generation_tokens_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Host and memory",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Available memory",
      "description": "Unified memory: this is the number that predicts OOM, not any GPU-side metric. GB10 reports no framebuffer fields at all.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 10000000000
              },
              {
                "color": "green",
                "value": 25000000000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "CPU utilisation",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (node) (rate(node_cpu_seconds_total{mode=\"idle\",node=~\"$node\"}[1m])) * 100)",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Fabric",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "RoCE interfaces \u2014 netdev",
      "description": "enp1s0f1np1 is rail 192.168.177.x, enP2p1s0f1np1 is rail 192.168.178.x. Both are 200 Gb/s. If only one moves during a P2P run, half the fabric is idle.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{device=~\"en.*np1\",node=~\"$node\"}[1m]) * 8",
          "legendFormat": "{{node}} {{device}} rx"
        },
        {
          "refId": "B",
          "expr": "rate(node_network_transmit_bytes_total{device=~\"en.*np1\",node=~\"$node\"}[1m]) * 8",
          "legendFormat": "{{node}} {{device}} tx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "InfiniBand port counters \u2014 RDMA only",
      "description": "These count RDMA traffic. Plain TCP over the same port does NOT appear here - verified with a 4 GiB scp that moved these by zero. Units still need calibrating against the measured 13.65 GB/s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_infiniband_port_data_received_bytes_total{node=~\"$node\"}[1m]) * 8",
          "legendFormat": "{{node}} {{device}}:{{port}} rx"
        },
        {
          "refId": "B",
          "expr": "rate(node_infiniband_port_data_transmitted_bytes_total{node=~\"$node\"}[1m]) * 8",
          "legendFormat": "{{node}} {{device}}:{{port}} tx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "vLLM and cache",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Requests running / waiting",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vllm:num_requests_running{node=~\"$node\"}",
          "legendFormat": "{{node}} running"
        },
        {
          "refId": "B",
          "expr": "vllm:num_requests_waiting{node=~\"$node\"}",
          "legendFormat": "{{node}} waiting"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Device prefix cache hit rate",
      "description": "vLLM's own device-side cache. Compare against LMCache retained keys in the logs panel - three views of one event, and disagreement is how a silently no-opping connector is caught.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(vllm:prefix_cache_hits_total{node=~\"$node\"}[2m]) / rate(vllm:prefix_cache_queries_total{node=~\"$node\"}[2m])",
          "legendFormat": "{{node}}"
