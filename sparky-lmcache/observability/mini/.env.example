# Host port overrides. The compose defaults already avoid the ports used by the
# other stack on this Mac (staycurio holds 3000, 3001, 9090, 4312, 9646), so
# this file is only needed if those defaults collide too.
#
#   published    default   why not the usual port
#   prometheus   9091      staycurio-prometheus holds 9090
#   grafana      3002      staycurio-web holds 3000, admin-web holds 3001
#   loki         3102      staycurio-loki would hold 3100 when running
#   tempo otlp   4317/4318 free
#
# Container-internal ports are NOT affected by these. Grafana still reaches
# prometheus:9090, loki:3100 and tempo:3200 over the compose network, and
# tempo's metrics_generator still writes to prometheus:9090. Only host
# publishing changes.
#
# Ports that must stay reachable from the Sparks:
#   LOKI_PORT        promtail pushes logs here
#   OTLP_GRPC_PORT   vLLM / LMCache / Dynamo push traces here
#   OTLP_HTTP_PORT
# Change those and observability/spark/spark-exporters.sh must match.
#
# Before assuming a port is genuinely taken, check who holds it:
#   lsof -nP -iTCP -sTCP:LISTEN | grep -E ':(3002|3102|4317|4318|9091) '
# If the holder is an `ssh` process on ~/.colima/_lima/colima/ssh.sock, that is
# colima's own port forward. `colima restart` clears leaked ones; do not kill
# that PID, it is the docker socket.

PROM_PORT=9091
GRAFANA_PORT=3002
LOKI_PORT=3102
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
